# Postgres connection string.
# Local development: the docker container described in the README.
# Production: the pooled connection string from Neon (append ?sslmode=require).
DATABASE_URL=postgresql://boka:boka@127.0.0.1:55432/boka

# Every request must send this value as the X-API-Key header.
# Generate your own, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-with-a-long-random-string

# Keeps timestamp handling deterministic.
TZ=UTC
